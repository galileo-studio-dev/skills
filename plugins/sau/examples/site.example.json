{
  "$schema": "../profile.schema.json",
  "schema_version": 1,
  "site": "example",
  "domain": "www.example.com",
  "locale": "es-ES",
  "alternate_locales": ["en"],
  "dataforseo": { "location_code": 2724, "language_code": "es" },
  "brief": "seo/site-brief.md",
  "output_dir": "seo/output",
  "code_repo": "example-org/example-web",
  "code_repo_path": "../example-web",
  "content_repo": "example-org/example-seo",
  "base_branch": "dev",
  "production_branch": "main",
  "branch_prefix": "sau/",
  "git_author_email": "seo-bot@example.com",
  "mode": "page",
  "motion": "plan-only",
  "checks": ["npm run lint", "npm run build"],
  "scan_paths": ["src/"],
  "existing_pages": ["src/content/routes.ts"],
  "tanda": {
    "content_dirs": ["src/content/pages/"],
    "shared_files": ["src/content/routes.ts", "src/content/pages/index.ts"]
  },
  "forbidden_terms_file": "seo/forbidden-terms.txt",
  "legal_review": "informative",
  "legal_agent": "legal-reviewer",
  "linear": {
    "team": "Example Team",
    "label": "seo",
    "project": "Website",
    "milestone": "Q4 pages",
    "assignee": "owner@example.com",
    "title_prefix": "SEO: "
  },
  "preview": "url",
  "local_preview_cmd": "npm run start -- -p {port}",
  "publish_check": "deployment",
  "publish_notes": ["Check that the preview deployment is READY before sharing the link."],
  "close_notes": ["Tell the team which pages went live."],
  "sar_register": true,
  "request_indexing": true,
  "onpage_min": 90
}
